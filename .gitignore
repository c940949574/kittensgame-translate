# 词表缓存（tools/verify.mjs 拉取线上 en/zh 后落地，离线兜底用）
.cache/

# 编辑器与系统文件
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 日志与临时文件
*.log
npm-debug.log*
tmp/
_scratch/

# 全量包是本地实测用的实验产物，不入库（tools/build-full.mjs 生成，--clean 清理）
dist/*-full.user.js

# 注意：dist/ 是**故意入库**的，方便直接从 raw URL 安装 userscript。
# 改了 locales/ 一定要重新跑 node tools/build.mjs 并把 dist/ 一起提交。
